# ---- Model ----
# models/ ở gốc repo = nơi training/4_train.py ghi ra trên laptop (.keras,
# .oof.npz, bản nháp). KHÔNG đẩy. Model dùng để bay nằm trong gói ROS, chép sang
# bằng training/5_export_to_ros.py và ĐƯỢC đẩy lên.
*.pt
*.onnx
*.whl
# "/models/" có dấu / đầu: CHỈ thư mục ở gốc. Viết "models/" là chặn luôn
# gesture_bringup/models/ và dòng ! bên dưới không mở lại được.
/models/
*.tflite
!ros2_ws/src/gesture_bringup/models/*.tflite

